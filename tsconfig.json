{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "checkJs": false,
    "erasableSyntaxOnly": true,
    "experimentalDecorators": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    // Storybook 11 types `storybook/theming` as the create-only entry while the browser build still
    // exports the Emotion API (and 10.x has no `storybook/theming/emotion`). Prefer the Emotion
    // declarations when present, else fall back to the default ones.
    "paths": {
      "storybook/theming": [
        "./node_modules/storybook/dist/theming/emotion.d.ts",
        "./node_modules/storybook/dist/theming/index.d.ts"
      ]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": true,
    "target": "es2020",
    "useDefineForClassFields": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true
  }
}
